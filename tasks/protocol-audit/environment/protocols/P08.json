{
  "analyst_note": "Hold out whole analysis entities using the curated map v2.",
  "dedup": null,
  "entity_split": {
    "assignment": "hash_bucket",
    "group_key": "analysis_entity_id",
    "hash": {
      "digest_slice": "hexdigest()[:8]",
      "encoding": "utf-8",
      "function": "sha256",
      "input": "<salt>:<assignment_unit_id>",
      "modulus": 100,
      "rule": "bucket < train_below -> train; else -> calibration",
      "to_int": "base 16"
    },
    "key": "analysis_entity_id",
    "key_source": "/app/protocols/entity_map_v2.csv",
    "salt": "tb3-p08-s15",
    "train_below": 70,
    "unmapped_company_policy": "a company in the panel with no row in the referenced map takes the assignment unit id 'UNMAPPED_' followed by its company_id, so each unmapped company is its own unit"
  },
  "folds": null,
  "name": "Analysis-entity holdout",
  "nested": null,
  "protocol_id": "P08",
  "recipe_type": "entity_hash",
  "row_filter": null,
  "stratify": null,
  "temporal_split": {
    "calibration": {
      "fiscal_year": "in [2018, 2019]"
    },
    "evaluation": {
      "period_index": ">= 28"
    },
    "train": {
      "period_index": "<= 19"
    }
  }
}