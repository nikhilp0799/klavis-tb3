{
  "analyst_note": "Restrict to filers with no affiliated entity, then split by company.",
  "dedup": null,
  "entity_split": {
    "assignment": "hash_bucket",
    "hash": {
      "digest_slice": "hexdigest()[:8]",
      "encoding": "utf-8",
      "function": "sha256",
      "input": "<salt>:<assignment_unit_id>",
      "modulus": 100,
      "rule": "bucket < train_below -> train; else -> calibration",
      "to_int": "base 16"
    },
    "key": "company_id",
    "salt": "tb3-p04",
    "train_below": 70
  },
  "folds": null,
  "name": "Standalone-filer company holdout",
  "nested": null,
  "protocol_id": "P04",
  "recipe_type": "entity_hash",
  "row_filter": {
    "expression": "filer_group has exactly one distinct company_id in the panel"
  },
  "stratify": null,
  "temporal_split": {
    "calibration": {
      "fiscal_year": "in [2018, 2019]"
    },
    "evaluation": {
      "period_index": ">= 28"
    },
    "train": {
      "period_index": "<= 19"
    }
  }
}